@echo off
chcp 65001 > nul
title النشر الفوري المجاني على Netlify Drop (بدون أي حساب أو تعقيدات)
color 0B

echo ======================================================================
echo          النشر الفوري لمنظومة نوك على دومين مجاني دائم (Netlify Drop)
echo ======================================================================
echo.

echo [1/2] جاري بناء وتجهيز أحدث نسخة من ملفات الموقع...
call npm run build:renderer
if %errorlevel% neq 0 (
    echo [خطأ] فشل البناء.
    pause
    exit /b %errorlevel%
)
echo [✓] تم تجهيز الملفات بنجاح.
echo.

echo [2/2] جاري فتح صفحة النشر السحابي ومجلد الموقع...
echo.
echo ======================================================================
echo                           الخطوة الوحيدة:
echo  اسحب المجلد المفتوح أمامك (renderer) وأفلته داخل صفحة المتصفح (Drop)
echo ======================================================================
echo.
echo ستحصل مباشرة وخلال 5 ثوانٍ على دومين مجاني دائم وسريع جداً!
echo.

:: فتح موقع Netlify Drop في المتصفح
start https://app.netlify.com/drop

:: فتح مجلد dist في متصفح ملفات ويندوز وتحديد مجلد renderer
explorer /select,"%~dp0dist\renderer"

pause

@echo off
chcp 65001 > nul
title النشر السحابي التلقائي لمنظومة نوك على Vercel
color 0B

echo ======================================================================
echo          نشر منظومة نوك NOAK ERP على خوادم Vercel السحابية
echo ======================================================================
echo.

:: 1. بناء أحدث ملفات الواجهة
echo [1/3] جاري تجهيز وبناء ملفات المنظومة...
call npm run build:renderer
if %errorlevel% neq 0 (
    echo [خطأ] فشل بناء ملفات الموقع.
    pause
    exit /b %errorlevel%
)
echo [✓] تم تجهيز الملفات بنجاح.
echo.

:: 2. التحقق من تسجيل الدخول إلى Vercel
echo [2/3] جاري التحقق من الاتصال بحسابك في Vercel...
call npx vercel whoami > nul 2>&1
if %errorlevel% neq 0 (
    echo.
    echo ------------------------------------------------------------------
    echo [تنبيه] يتطلب Vercel تأكيد حسابك لمرة واحدة فقط.
    echo سيتم الآن فتح المتصفح؛ اختر حسابك في جوجل أو بريدك للموافقة.
    echo ------------------------------------------------------------------
    echo.
    call npx vercel login
    if %errorlevel% neq 0 (
        echo [خطأ] تعذر تسجيل الدخول إلى Vercel. يرجى المحاولة مجدداً.
        pause
        exit /b 1
    )
)
echo [✓] تم الاتصال بحساب Vercel بنجاح!
echo.

:: 3. النشر المباشر السحابي الدائم
echo [3/3] جاري رفع ونشر المنظومة على سيرفرات Vercel العالمية...
echo يرجى الانتظار بضع ثوانٍ...
echo.

call npx vercel --prod --yes

echo.
echo ======================================================================
echo                    تهانينا! تم النشر بنجاح!
echo ======================================================================
echo.
echo أصبح تطبيقك متاحاً أون لاين على دومين Vercel المجاني والدائم.
echo.
pause

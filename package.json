{
  "name": "noak-erp",
  "version": "1.0.0",
  "type": "module",
  "description": "NOAK ERP — Enterprise Management System for Woodwork & Aluminum Fabrication",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main/index.cjs --external:electron --external:pg",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main/preload.cjs --external:electron",
    "build": "tsc --noEmit && npm run build:renderer && npm run build:main && npm run build:preload",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "predeploy": "npm run build:renderer",
    "deploy": "gh-pages -d dist/renderer",
    "package:win": "npm run build && electron-builder --win"
  },
  "keywords": [
    "erp",
    "accounting",
    "manufacturing",
    "woodwork",
    "aluminum",
    "arabic-rtl",
    "postgresql"
  ],
  "author": "NOAK Technologies",
  "license": "Proprietary",
  "dependencies": {
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.363.0",
    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.4",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
